  hintText: "\u0427\u0438\u0442\u0430\u0442\u044C"
  noteText: "\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u0438
    \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043D\u0430 \u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0435
