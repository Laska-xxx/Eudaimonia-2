  <NpsName>k__BackingField: "\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446"
  <NpsPhrases>k__BackingField:
  - "\u0411\u0435\u0440\u0438 \u0447\u0442\u043E \u0445\u043E\u0447\u0435\u0448\u044C,
    \u043B\u044E\u0434\u0435\u0439 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043C\u0430\u043B\u043E, \u0442\u0430\u043A \u0447\u0442\u043E \u0432\u0441\u0435
    \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
  - "\u042F \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B
    \u0441 \u043B\u044E\u0434\u044C\u043C\u0438 "
  - "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u0430\u0440\u0443
    \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u044F \u0438\u043D\u043E\u0433\u0434\u0430
    \u0437\u0430\u0431\u044B\u0432\u0430\u044E \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C "
  - "\u0410 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0436\u0435\u043D\u0430
    \u0438 \u0434\u0435\u0442\u0438? "
  - "\u2026 "
  - "\u0423 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u0431\u044B\u0432\u0448\u0430\u044F
    \u0436\u0435\u043D\u0430 \u0438 \u0441\u044B\u043D,\u0435\u043C\u0443 \u043D\u0430\u0432\u0435\u0440\u043D\u043E
    \u0449\u0430\u0441 23 "
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u0430 \u044F \u0434\u0430\u0432\u043D\u043E
    \u0438\u0445 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B"
  - "\u0427\u0430\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E
    \u0433\u0430\u043B\u0435\u0440\u0435\u044E \u0432 \u0441\u0442\u0430\u0440\u043E\u043C
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435, \u0441\u043C\u043E\u0442\u0440\u044E
    \u0440\u0438\u0441\u0443\u043D\u043A\u0438 \u0438 \u0433\u0440\u0430\u043C\u043E\u0442\u044B
    \u0441\u044B\u043D\u0430, \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u0441\u043E \u0441\u0432\u0430\u0434\u044C\u0431\u044B \u0441 \u0436\u0435\u043D\u043E\u0439"
  - "\u042F \u043F\u043E\u043C\u043D\u044E \u0435\u0435 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0439
    \u0441\u0430\u043B\u0430\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u044F
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0442\u0435\u0440\u043F\u0435\u0442\u044C
    \u043D\u0435 \u043C\u043E\u0433,\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
    \u043E\u043D\u0430 \u0442\u0443\u0434\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u043B\u0430
    \u043B\u0443\u043A"
  - "\u042F \u043D\u0435 \u043B\u044E\u0431\u0438\u043B \u043B\u0443\u043A, \u043D\u043E
    \u0442\u0435\u0440\u043F\u0435\u043B"
  - "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u043F\u043B\u0430\u0447\u0443 \u043F\u043E
    \u043D\u043E\u0447\u0430\u043C \u0438 \u0434\u0443\u043C\u0430\u044E \u043F\u043E\u0439\u0442\u0438
    \u0437\u0430 \u043D\u0438\u043C\u0438, \u0443\u0441\u043D\u0443\u0442\u044C \u0432
    \u043A\u0430\u043F\u0441\u0443\u043B\u0435"
  - "\u041D\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u0442\u0440\u0430\u0448\u043D\u043E,
    \u0447\u0442\u043E \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0437\u0430\u0445\u043E\u0447\u0443
    \u0432\u044B\u043B\u0435\u0437\u0430\u0442\u044C \u0438 \u0443\u0439\u0434\u0443
    \u0432 \u201C\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u041C\u0438\u0440\u201D "
  - "\u042F \u043D\u0430\u0432\u0435\u0440\u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043C\u043D\u043E\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u044E, \u043F\u0440\u043E\u0441\u0442\u0438"
  - ...
  <EndPhrase>k__BackingField: "\u042F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E
    \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435..."
