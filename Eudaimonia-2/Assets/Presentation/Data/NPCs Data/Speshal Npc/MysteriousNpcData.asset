  m_Name: MysteriousNpcData
  m_EditorClassIdentifier: Assembly-CSharp::Features.Interactable.NPS.NpsPhrasesSO
  <NpsName>k__BackingField: "\u0410\u043B\u0438\u0441\u0430"
  <NpsPhrases>k__BackingField:
  - "\u041E, \u043F\u0440\u0438\u0432\u0435\u0442"
  - "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u0441\u044E\u0434\u0430 \u0443\u0436\u0435
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442\u0441\u044F"
  - "\u0422\u044B \u0447\u0435\u0433\u043E \u0442\u0443\u0442 \u0437\u0430\u0431\u044B\u043B?"
  - "\u041C\u043E\u0436\u0435\u0448\u044C \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C,
    \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u043B\u0438\u0446\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E,
    \u0447\u0442\u043E \u0442\u044B \u0441\u0430\u043C \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
    \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F"
  - "\u0417\u043D\u0430\u0435\u0448\u044C, \u0434\u043E \u0442\u043E\u0433\u043E,
    \u043A\u0430\u043A \u0432\u0441\u044F \u043C\u043E\u044F \u0441\u0435\u043C\u044C\u044F
    \u0443\u0441\u043D\u0443\u043B\u0430, \u043C\u043D\u0435 \u0442\u043E\u0436\u0435
    \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B\u0438 \u043B\u0435\u0447\u044C
    \u0432 \u043A\u0430\u043F\u0441\u0443\u043B\u0443 "
  - "\u041D\u043E \u044F \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C!"
  - "\u0412 \u043A\u0430\u043F\u0441\u0443\u043B\u0435 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0435\u043F\u043B\u043E \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E...
    \u0430\u0436 \u0442\u043E\u0448\u043D\u0438\u0442"
  - "\u041A\u0430\u043A\u0430\u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u044B\u0433\u043E\u0434\u0430
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E.."
  - ...
  - "\u041B\u0430\u0434\u043D\u043E, \u043D\u0435 \u0431\u0435\u0440\u0438 \u0432
    \u0433\u043E\u043B\u043E\u0432\u0443"
  - "\u0425\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0435\u0441\u0442\u044C
    \u0440\u044F\u0434\u043E\u043C, \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0438\u0445\u043E"
  <EndPhrase>k__BackingField: "\u0425\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u0448\u044C
    \u0441\u0435\u0441\u0442\u044C \u0440\u044F\u0434\u043E\u043C, \u0442\u043E\u043B\u044C\u043A\u043E
    \u0442\u0438\u0445\u043E"
