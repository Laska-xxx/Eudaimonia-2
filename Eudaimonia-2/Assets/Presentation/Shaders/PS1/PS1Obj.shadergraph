{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "92dfb2f50e8b4ca5866a9724b2f0952d",
    "m_Group": {
        "m_Id": "71853f79941944ccab50733d646fc5ed"
    },
    "m_Name": "PS1Jitter (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -486.0000305175781,
            "y": 23.999914169311525,
            "width": 243.9999542236328,
            "height": 118.0000228881836
        }
    },
    "m_Slots": [
        {
            "m_Id": "7627149f47f04d359627df1f27da80bc"
        },
        {
            "m_Id": "be47ca32c83b412f99299eee0564fe03"
        },
        {
            "m_Id": "35aa045f03c74eff849406ae2a10e497"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PS1Jitter",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\nfloat4 clipPos = TransformObjectToHClip(VertexPosition);\n\nclipPos.xyz = clipPos.xyz / clipPos.w;\nclipPos.x = floor(clipPos.x * JitterResolution) / JitterResolution;\nclipPos.y = floor(clipPos.y * JitterResolution) / JitterResolution;\nclipPos.xyz *= clipPos.w;\n\nfloat4 worldPos = mul(UNITY_MATRIX_I_VP, clipPos);\nOutPosition = mul(GetWorldToObjectMatrix(), worldPos).xyz;"
}

