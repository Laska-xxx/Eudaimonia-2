      propertyPath: noteText
      value: "\u0422\u0420\u0415\u0411\u0423\u042E\u0422\u0421\u042F \u0420\u0410\u0411\u041E\u0427\u0418\u0415\r\n\r\n\u041D\u0443\u0436\u043D\u044B
        \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0440\u0443\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0438\u043C\u0435\u044E\u0442 \u0445\u043E\u0442\u044C \u043A\u0430\u043A\u043E\u0439
        \u0442\u043E \u043E\u043F\u044B\u0442\r\n\u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0430
        \u043E\u0431\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0438\r\n\u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0439
