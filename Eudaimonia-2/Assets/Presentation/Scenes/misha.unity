--- !u!1001 &8388740098649430617
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 715715273}
    m_Modifications:
    - target: {fileID: 2100252379372267422, guid: add2ba9db61710b45afb4b929484815e, type: 3}
      propertyPath: m_Name
      value: Note
      objectReference: {fileID: 0}
    - target: {fileID: 7974020518227338085, guid: add2ba9db61710b45afb4b929484815e, type: 3}
      propertyPath: noteText
      value: "\u0422\u042B \u0423\u0421\u0422\u0410\u041B \u0416\u0418\u0422\u042C
        \u0412 \u041C\u0418\u0420\u0415, \u0413\u0414\u0415 \u041D\u0423\u0416\u041D\u041E
        \u0420\u0410\u0411\u041E\u0422\u0410\u0422\u042C? \u0422\u0410\u041A \u041F\u041E\u0413\u0420\u0423\u0417\u0418\u0421\u042C
        \u0412 \u0412\u0415\u0427\u041D\u042B\u0419 \u0421\u041E\u041D!!!\r\n\r\n\u0417\u0430\u0433\u0440\u0443\u0437\u0438
        \u0441\u0432\u043E\u0435 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
        \u0432 \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u044C,\u0447\u0442\u043E\u0431\u044B
        \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043F\u0430\u0441\u0442\u044C
        \u0432 \u0441\u0432\u0435\u0442\u043B\u043E\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435,
        \u0433\u0434\u0435 \u043D\u0438\u043A\u0442\u043E \u043E\u0442 \u0442\u0435\u0431\u044F
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442!\r\n\u041A\u0430\u043A
        \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442:\r\n\u0422\u044B
        \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0448\u044C \u0432 \u043A\u0430\u043F\u0441\u0443\u043B\u0435\r\n\u0422\u0432\u043E\u0439
        \u0440\u0430\u0437\u0443\u043C \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044F
        \u0432 \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u044C\r\n\u0442\u044B
        \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u0448\u044C\u0441\u044F
        \u0432 \u0442\u043E \u0431\u0443\u0434\u0443\u0449\u0435\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
        \u0436\u0435\u043B\u0430\u0435\u0448\u044C \u0438\u043C\u0435\u043D\u043D\u043E
        \u0442\u044B\r\n\u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442
        \u0442\u0435\u0431\u044F,\u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F\r\n\u0432\u0430\u0448
        \u0441\u043E\u043D - \u043D\u0430\u0448\u0430 \u0437\u0430\u0431\u043E\u0442\u0430.
        \r\n\u0435\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E
        \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0441\u0435 \u043E\u0442\u0431\u0440\u043E\u0441\u0438\u0442\u044C,
        \u0437\u0432\u043E\u043D\u0438\u0442\u0435 \u043F\u043E \u043D\u043E\u043C\u0435\u0440\u0443
        \u0445\u0445\u0445\u0445\u0445\u0445\u0445\u0445\u0445"
      objectReference: {fileID: 0}
    - target: {fileID: 8195065868527252800, guid: add2ba9db61710b45afb4b929484815e, type: 3}
